# Base URL of the deployed app (used to build OAuth redirect URIs and email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret Vercel Cron sends as a bearer token when triggering /api/cron/* routes
CRON_SECRET=

# Database (Neon or Supabase Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/reputation_dashboard"

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Google Business Profile API (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Graph API (https://developers.facebook.com)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Claude API (https://console.anthropic.com) — drafts review replies
ANTHROPIC_API_KEY=

# Resend (email alerts) and Twilio (SMS alerts)
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
